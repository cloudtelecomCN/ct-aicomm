{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/pilot/enterprise-pilot-acceptance.v1.json",
  "title": "CT-AIComm enterprise pilot acceptance package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pilot_id", "status", "data_origin", "scenario", "environment_fingerprint", "responsibilities", "acceptance_metrics", "execution_boundary", "data_boundary", "exit_plan", "decision"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "pilot_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "status": { "enum": ["draft", "approved", "active", "accepted", "qualified", "rejected", "exited"] },
    "data_origin": { "enum": ["synthetic", "measured"] },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "business_question", "in_scope", "out_of_scope", "start_at", "end_at"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "business_question": { "type": "string", "minLength": 10 },
        "in_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "out_of_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": "string", "format": "date-time" }
      }
    },
    "environment_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "responsibilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["deliverable", "responsible", "accountable", "consulted", "informed"],
        "properties": {
          "deliverable": { "type": "string", "minLength": 1 },
          "responsible": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "accountable": { "type": "string", "minLength": 1 },
          "consulted": { "type": "array", "items": { "type": "string" } },
          "informed": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "acceptance_metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "definition", "unit", "comparison", "target", "minimum_samples", "evidence_required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "definition": { "type": "string", "minLength": 3 },
          "unit": { "type": "string", "minLength": 1 },
          "comparison": { "enum": ["less_than", "less_than_or_equal", "greater_than", "greater_than_or_equal", "no_regression"] },
          "target": { "type": "number" },
          "minimum_samples": { "type": "integer", "minimum": 1 },
          "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "execution_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["initial_mode", "human_approval_required", "automatic_execution_scope", "rollback_required", "change_window_required"],
      "properties": {
        "initial_mode": { "const": "observe_only" },
        "human_approval_required": { "const": true },
        "automatic_execution_scope": { "type": "array", "items": { "type": "string" } },
        "rollback_required": { "const": true },
        "change_window_required": { "const": true }
      }
    },
    "data_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "prohibited", "retention_days", "encryption_in_transit", "encryption_at_rest", "access_roles", "export_approval_required", "deletion_verification_required"],
      "properties": {
        "allowed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "prohibited": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "encryption_in_transit": { "const": true },
        "encryption_at_rest": { "const": true },
        "access_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "export_approval_required": { "const": true },
        "deletion_verification_required": { "const": true }
      }
    },
    "exit_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["triggers", "restore_baseline", "uninstall_agent", "export_evidence", "delete_restricted_data", "close_access", "owner"],
      "properties": {
        "triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "restore_baseline": { "const": true },
        "uninstall_agent": { "const": true },
        "export_evidence": { "const": true },
        "delete_restricted_data": { "const": true },
        "close_access": { "const": true },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "customer_approver", "provider_approver", "independent_review", "evidence_sha256"],
      "properties": {
        "state": { "enum": ["pending", "accepted", "qualified", "rejected"] },
        "customer_approver": { "type": ["string", "null"] },
        "provider_approver": { "type": ["string", "null"] },
        "independent_review": { "type": ["string", "null"] },
        "evidence_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    }
  }
}
