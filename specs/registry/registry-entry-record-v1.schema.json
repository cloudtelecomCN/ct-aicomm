{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/ct-aicomm/registry-entry-record-v1.schema.json",
  "title": "CT-AIComm signed Registry entry record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry", "integrity", "signature"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "category", "summary", "specification_urls", "implementation_urls", "interoperability_tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "category": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "summary": { "type": "string", "minLength": 20, "maxLength": 500 },
        "specification_urls": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "implementation_urls": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "interoperability_tags": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entry_id", "entry_version", "sequence", "status", "published_at", "source_contribution", "review_receipt_digest", "previous_version_digest", "protocol", "artifacts"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "entry_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "entry_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["published", "deprecated"] },
        "published_at": { "type": "string", "format": "date-time" },
        "source_contribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "review_receipt_digest": { "$ref": "#/$defs/sha256" },
        "previous_version_digest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "protocol": { "$ref": "#/$defs/protocol" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "media_type", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
              "media_type": { "type": "string", "minLength": 3, "maxLength": 120 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "entry_digest"],
      "properties": {
        "canonicalization": { "const": "ct-aicomm-json-v1" },
        "entry_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id", "signed_at", "value"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "signed_at": { "type": "string", "format": "date-time" },
        "value": { "type": "string", "pattern": "^base64:[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  }
}
