{
  "schema_version": "1.0.0",
  "environment_id": "ct-aicomm-contributor-v1",
  "runtime": {
    "minimum_node_major": 22,
    "ci_node_major": 24,
    "package_install_required": false,
    "external_dependencies": []
  },
  "security_boundary": {
    "network_mode": "loopback-only",
    "external_network_allowed": false,
    "credentials_required": false,
    "private_infrastructure_required": false,
    "forwarded_environment_variables": [
      "CI",
      "COMSPEC",
      "HOME",
      "NO_COLOR",
      "PATH",
      "PATHEXT",
      "SystemRoot",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "WINDIR"
    ]
  },
  "evidence_boundary": {
    "data_origin": "synthetic",
    "performance_claim_allowed": false,
    "measured_production_result": false
  },
  "profiles": {
    "contracts": "Run the stable public SDK, Agent, Registry, and CT-DSL contract tests.",
    "scenarios": "Run executable synthetic examples and verify their evidence labels.",
    "all": "Run contracts and synthetic scenarios.",
    "full": "Run every public Node test in the repository."
  },
  "contract_tests": [
    "tests/agent-protocol-sdk.test.mjs",
    "tests/compliance-audit-package.test.mjs",
    "tests/compliance-data-path-declaration.test.mjs",
    "tests/compliance-evidence-gap.test.mjs",
    "tests/compliance-evidence-binding.test.mjs",
    "tests/connector-sdk-contract.test.mjs",
    "tests/ct-dsl.test.mjs",
    "tests/evidence-derivation.test.mjs",
    "tests/evidence-export-authorization.test.mjs",
    "tests/evidence-invalidation.test.mjs",
    "tests/evidence-content-integrity.test.mjs",
    "tests/evidence-import.test.mjs",
    "tests/evidence-object-schema.test.mjs",
    "tests/evidence-lifecycle.test.mjs",
    "tests/public-sdk-boundary.test.mjs",
    "tests/registry-entry-integrity.test.mjs"
  ],
  "synthetic_scenarios": [
    {
      "id": "public-evidence-contract",
      "entrypoint": "examples/sdk/validate-public-evidence.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false
        }
      }
    },
    {
      "id": "connector-contract",
      "entrypoint": "examples/connectors/synthetic-static-connector.mjs",
      "expect": {
        "equals": {
          "passed": true
        },
        "every": {
          "data_origins": "synthetic"
        }
      }
    },
    {
      "id": "agent-protocol-contract",
      "entrypoint": "examples/agent/protocol-sdk.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false
        }
      }
    },
    {
      "id": "registry-history-verification",
      "entrypoint": "scripts/verify-registry-history.mjs",
      "arguments": [
        "registry/entries/synthetic-quic-example/history.json"
      ],
      "expect": {
        "equals": {
          "artifacts_verified": true,
          "data_origin": "synthetic",
          "performance_claim_allowed": false
        }
      }
    },
    {
      "id": "audit-package-verification",
      "entrypoint": "scripts/verify-audit-package.mjs",
      "arguments": [
        "examples/compliance/synthetic-audit-package",
        "--tenant",
        "tenant-synthetic-alpha",
        "--workload",
        "workload-inference-synthetic",
        "--execution",
        "execution-synthetic-001"
      ],
      "expect": {
        "equals": {
          "integrity_verified": true,
          "context_verified": true,
          "evidence_origin": "synthetic",
          "authenticity_verified": false,
          "authorization_verified": false,
          "legal_or_certification_conclusion": false
        }
      }
    },
    {
      "id": "evidence-gap-detection",
      "entrypoint": "examples/compliance/generate-synthetic-evidence-gap-report.mjs",
      "expect": {
        "equals": {
          "default_deny": true,
          "status": "not_satisfied",
          "requirements_satisfied": false,
          "gap_count": 4,
          "evidence_origin": "synthetic",
          "authorization_verified": false,
          "legal_or_certification_conclusion": false
        }
      }
    },
    {
      "id": "evidence-lifecycle",
      "entrypoint": "examples/evidence/lifecycle-synthetic.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false,
          "final_lifecycle_state": "expired",
          "single_status_allowed": false,
          "certification_issued": false
        }
      }
    },
    {
      "id": "evidence-content-integrity",
      "entrypoint": "scripts/verify-evidence-content.mjs",
      "arguments": [
        "examples/evidence/v1",
        "--expected-manifest",
        "sha256:4cee25b68abd0074163f61602efc140047e2671cc3cafaffc2b8964d1821543d"
      ],
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "object_count": 9,
          "integrity_verified": true,
          "external_anchor_verified": true,
          "authenticity_verified": false,
          "authorization_verified": false,
          "independent_review_verified": false,
          "certification_issued": false
        }
      }
    },
    {
      "id": "artifact-derivation-lineage",
      "entrypoint": "examples/evidence/derivation-synthetic.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false,
          "declared_field_count": 4,
          "raw_values_included": false,
          "private_source_required_for_full_review": true,
          "record_integrity_verified": true,
          "exact_version_lineage_verified": true,
          "policy_anchor_verified": true,
          "source_content_bytes_verified": false,
          "authenticity_verified": false,
          "authorization_verified": false,
          "certification_issued": false
        }
      }
    },
    {
      "id": "evidence-import-idempotency",
      "entrypoint": "examples/evidence/import-synthetic.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false,
          "committed_outcome": "committed",
          "exact_retry_idempotent": true,
          "same_content_outcome": "replayed",
          "stored_object_count": 9,
          "attempt_count": 3,
          "different_request_same_key_outcome": "rejected",
          "failed_attempt_recorded": true,
          "append_only_chain_verified": true,
          "authenticity_verified": false,
          "authorization_verified": false,
          "certification_issued": false
        }
      }
    },
    {
      "id": "evidence-export-authorization",
      "entrypoint": "examples/evidence/export-authorization-synthetic.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false,
          "allowed_decision_count": 1,
          "denied_decision_count": 1,
          "delivered_count": 1,
          "cross_tenant_denied": true,
          "append_only_chain_verified": true,
          "raw_export_content_recorded": false,
          "principal_authentication_verified": false,
          "transport_attestation_verified": false,
          "certification_issued": false
        }
      }
    },
    {
      "id": "evidence-downstream-invalidation",
      "entrypoint": "examples/evidence/downstream-invalidation-synthetic.mjs",
      "expect": {
        "equals": {
          "data_origin": "synthetic",
          "performance_claim_allowed": false,
          "event_type": "evidence.superseded",
          "consumer_count": 3,
          "event_invalidated_count": 3,
          "idempotent_replay_count": 3,
          "ttl_fallback_invalidated": true,
          "all_downstreams_eventually_invalidated": true,
          "replacement_version": "1.1.0",
          "delivery_semantics": "at-least-once",
          "fail_closed_on_ttl_expiry": true,
          "certification_issued": false
        }
      }
    }
  ],
  "container": {
    "dockerfile": "containers/contributor/Dockerfile",
    "runtime_user": "node",
    "recommended_runtime_flags": [
      "--network=none",
      "--read-only",
      "--tmpfs=/tmp"
    ]
  }
}
