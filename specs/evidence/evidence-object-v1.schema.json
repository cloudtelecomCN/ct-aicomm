{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/evidence/evidence-object-v1.schema.json",
  "title": "CT-AIComm evidence object v1",
  "description": "Strict public contract for the nine shared Evidence Core object types. Schema conformance does not establish measurement validity, independence, authorization, or certification.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/scope" },
    { "$ref": "#/$defs/method" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/artifact" },
    { "$ref": "#/$defs/evidenceVersion" },
    { "$ref": "#/$defs/review" },
    { "$ref": "#/$defs/policyDecision" },
    { "$ref": "#/$defs/exportGrant" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "authorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "purpose", "recipients", "expires_at"],
      "properties": {
        "visibility": { "enum": ["private", "shared", "public"] },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 240 },
        "recipients": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "objectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id"],
      "properties": {
        "object_type": {
          "enum": ["scope", "method", "run", "observation", "artifact", "evidence_version", "review", "policy_decision", "export_grant"]
        },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": { "$ref": "#/$defs/instant" },
        "ends_at": { "$ref": "#/$defs/instant" }
      }
    },
    "scope": {
      "title": "Scope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "scope_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "sites", "endpoints", "direction", "purpose", "validity", "workload_class"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "scope" },
        "scope_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "sites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["site_id", "role", "region"],
            "properties": {
              "site_id": { "$ref": "#/$defs/id" },
              "role": { "enum": ["source", "destination", "observer"] },
              "region": { "type": "string", "minLength": 2, "maxLength": 96 }
            }
          }
        },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpoint_id", "site_id", "role"],
            "properties": {
              "endpoint_id": { "$ref": "#/$defs/id" },
              "site_id": { "$ref": "#/$defs/id" },
              "role": { "enum": ["source", "destination", "observer"] }
            }
          }
        },
        "direction": { "enum": ["unidirectional", "bidirectional"] },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 500 },
        "validity": { "$ref": "#/$defs/timeWindow" },
        "workload_class": { "enum": ["network-transfer", "inference", "training", "other"] }
      }
    },
    "method": {
      "title": "Method",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "method_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "tool", "parameters", "sampling", "exclusion_rules", "statistics", "environment_prerequisites"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "method" },
        "method_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "artifact_fingerprint"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "version": { "type": "string", "minLength": 1, "maxLength": 120 },
            "artifact_fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 96 },
              "value": { "type": ["string", "number", "integer", "boolean"] },
              "unit": { "type": ["string", "null"], "maxLength": 48 }
            }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_count", "interval_ms", "warmup_count"],
          "properties": {
            "target_count": { "type": "integer", "minimum": 1 },
            "interval_ms": { "type": "integer", "minimum": 0 },
            "warmup_count": { "type": "integer", "minimum": 0 }
          }
        },
        "exclusion_rules": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "description"],
            "properties": {
              "rule_id": { "$ref": "#/$defs/id" },
              "description": { "type": "string", "minLength": 3, "maxLength": 500 }
            }
          }
        },
        "statistics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "aggregations"],
            "properties": {
              "metric": { "type": "string", "minLength": 1, "maxLength": 96 },
              "aggregations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["raw", "count", "mean", "min", "max", "p50", "p95", "p99"] }
              }
            }
          }
        },
        "environment_prerequisites": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    },
    "run": {
      "title": "Run",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "run_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "scope_ref", "method_ref", "planned_window", "actual_window", "environment", "workload", "clock", "run_status", "exit_reason"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "run" },
        "run_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "scope_ref": { "$ref": "#/$defs/objectReference" },
        "method_ref": { "$ref": "#/$defs/objectReference" },
        "planned_window": { "$ref": "#/$defs/timeWindow" },
        "actual_window": { "$ref": "#/$defs/timeWindow" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment_id", "fingerprint", "summary"],
          "properties": {
            "environment_id": { "$ref": "#/$defs/id" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "summary": { "type": "string", "minLength": 3, "maxLength": 500 }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "origin", "configuration_fingerprint"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "version": { "type": "string", "minLength": 1, "maxLength": 120 },
            "origin": { "enum": ["synthetic", "production-like", "production"] },
            "configuration_fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "synchronized", "max_known_skew_ms"],
          "properties": {
            "source": { "type": "string", "minLength": 1, "maxLength": 120 },
            "synchronized": { "type": "boolean" },
            "max_known_skew_ms": { "type": "number", "minimum": 0 }
          }
        },
        "run_status": { "enum": ["planned", "running", "completed", "failed", "cancelled"] },
        "exit_reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "observation": {
      "title": "Observation",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "observation_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "run_ref", "observed_at", "metric", "value", "unit", "observation_point", "sample_count", "origin", "quality", "aggregation", "limitations"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "observation" },
        "observation_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "run_ref": { "$ref": "#/$defs/objectReference" },
        "observed_at": { "$ref": "#/$defs/instant" },
        "metric": { "type": "string", "minLength": 1, "maxLength": 96 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 48 },
        "observation_point": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "origin": { "enum": ["measured", "synthetic", "inferred", "declared"] },
        "quality": { "enum": ["valid", "partial", "invalid", "unknown"] },
        "aggregation": { "enum": ["raw", "count", "mean", "min", "max", "p50", "p95", "p99"] },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    },
    "artifact": {
      "title": "Artifact",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "artifact_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "kind", "media_type", "content_fingerprint", "size_bytes", "storage_locator", "classification", "derived_from"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "artifact" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "kind": { "enum": ["raw-samples", "log", "configuration", "method", "report", "other"] },
        "media_type": { "type": "string", "minLength": 3, "maxLength": 120 },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "storage_locator": { "type": "string", "format": "uri", "maxLength": 1000 },
        "classification": { "enum": ["public", "shared", "restricted"] },
        "derived_from": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/objectReference" }
        }
      }
    },
    "evidenceVersion": {
      "title": "EvidenceVersion",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "evidence_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "scope_ref", "method_ref", "run_refs", "observation_refs", "artifact_refs", "boundary", "status", "sealed_at", "content_fingerprint"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "evidence_version" },
        "evidence_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "scope_ref": { "$ref": "#/$defs/objectReference" },
        "method_ref": { "$ref": "#/$defs/objectReference" },
        "run_refs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/objectReference" } },
        "observation_refs": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/objectReference" } },
        "artifact_refs": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/objectReference" } },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "data_origin", "limitations", "performance_claim_allowed"],
          "properties": {
            "statement": { "type": "string", "minLength": 10, "maxLength": 1000 },
            "data_origin": { "enum": ["synthetic", "hybrid", "measured"] },
            "limitations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
            "performance_claim_allowed": { "type": "boolean" }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurement_validity", "content_integrity", "independent_review", "freshness", "policy_decision"],
          "properties": {
            "measurement_validity": { "enum": ["sufficient", "partial", "invalid", "unknown"] },
            "content_integrity": { "enum": ["passed", "failed", "unverifiable"] },
            "independent_review": { "enum": ["not-reviewed", "in-progress", "consistent", "deviation", "uncertain"] },
            "freshness": { "enum": ["valid", "expiring", "expired", "unknown"] },
            "policy_decision": { "enum": ["accepted", "rejected", "manual-review"] }
          }
        },
        "sealed_at": { "$ref": "#/$defs/instant" },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "review": {
      "title": "Review",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "review_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "evidence_ref", "reviewer", "independence_disclosure", "review_scope", "method", "findings", "conclusion", "concluded_at"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "review" },
        "review_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "evidence_ref": { "$ref": "#/$defs/objectReference" },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_id", "organization_id"],
          "properties": {
            "principal_id": { "$ref": "#/$defs/id" },
            "organization_id": { "$ref": "#/$defs/id" }
          }
        },
        "independence_disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relationship", "details", "independent_claim"],
          "properties": {
            "relationship": { "enum": ["none", "same-organization", "commercial", "implementation-participant", "other"] },
            "details": { "type": "string", "minLength": 3, "maxLength": 1000 },
            "independent_claim": { "type": "boolean" }
          }
        },
        "review_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["structure", "calculation", "supervised-run", "independent-rerun"] }
        },
        "method": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "severity", "statement"],
            "properties": {
              "finding_id": { "$ref": "#/$defs/id" },
              "severity": { "enum": ["info", "minor", "major", "critical"] },
              "statement": { "type": "string", "minLength": 3, "maxLength": 1000 }
            }
          }
        },
        "conclusion": { "enum": ["consistent", "deviation", "uncertain", "internal-only"] },
        "concluded_at": { "$ref": "#/$defs/instant" }
      }
    },
    "policyDecision": {
      "title": "PolicyDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "decision_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "consumer", "rule", "evidence_refs", "outcome", "reason", "decided_at"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "policy_decision" },
        "decision_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "consumer_id"],
          "properties": {
            "type": { "enum": ["human", "sla-workflow", "scheduler-adapter", "audit-workflow", "other"] },
            "consumer_id": { "$ref": "#/$defs/id" }
          }
        },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_id", "version", "fingerprint"],
          "properties": {
            "rule_id": { "$ref": "#/$defs/id" },
            "version": { "$ref": "#/$defs/version" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/objectReference" } },
        "outcome": { "enum": ["accepted", "rejected", "manual-review"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "decided_at": { "$ref": "#/$defs/instant" }
      }
    },
    "exportGrant": {
      "title": "ExportGrant",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "grant_id", "version", "tenant_id", "created_by", "created_at", "authorization_scope", "resource_refs", "recipient", "purpose", "field_scope", "expires_at", "watermark", "status"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "object_type": { "const": "export_grant" },
        "grant_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "resource_refs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/objectReference" } },
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_id", "organization_id"],
          "properties": {
            "principal_id": { "$ref": "#/$defs/id" },
            "organization_id": { "$ref": "#/$defs/id" }
          }
        },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 500 },
        "field_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
        },
        "expires_at": { "$ref": "#/$defs/instant" },
        "watermark": { "type": "string", "minLength": 3, "maxLength": 240 },
        "status": { "enum": ["active", "revoked", "expired"] }
      }
    }
  }
}
