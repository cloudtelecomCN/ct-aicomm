{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/passport/passport-sharing-v1.schema.json",
  "title": "CT-AIComm Link Evidence Passport governed sharing records v1",
  "description": "Time-limited sharing, append-only revocation, hash-referenced supplements, and buyer decisions. Buyer acceptance never changes platform evidence, review, freshness, policy, performance, or certification status.",
  "oneOf": [
    { "$ref": "#/$defs/shareGrant" },
    { "$ref": "#/$defs/shareRevocation" },
    { "$ref": "#/$defs/supplementRequest" },
    { "$ref": "#/$defs/supplementResponse" },
    { "$ref": "#/$defs/buyerDecision" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "referenceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id", "content_fingerprint"],
      "properties": {
        "object_type": { "type": "string" },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "passportReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_evidence_version" } } }
      ]
    },
    "deliveryReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_delivery_manifest" } } }
      ]
    },
    "shareReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_share_grant" } } }
      ]
    },
    "requestReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_supplement_request" } } }
      ]
    },
    "responseReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_supplement_response" } } }
      ]
    },
    "artifactReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "artifact" } } }
      ]
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "organization_id"],
      "properties": {
        "subject_id": { "$ref": "#/$defs/id" },
        "organization_id": { "$ref": "#/$defs/id" }
      }
    },
    "statusAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_validity", "content_integrity", "independent_review", "freshness", "policy_decision"],
      "properties": {
        "measurement_validity": { "enum": ["sufficient", "partial", "invalid", "unknown"] },
        "content_integrity": { "const": "passed" },
        "independent_review": { "const": "not-reviewed" },
        "freshness": { "const": "valid" },
        "policy_decision": { "const": "manual-review" }
      }
    },
    "shareGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "share_id", "version", "tenant_id", "created_by",
        "created_at", "recipient", "purpose", "passport_ref", "delivery_ref", "valid_from",
        "expires_at", "boundary", "content_fingerprint"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "passport_share_grant" },
        "share_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "created_by": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/instant" },
        "recipient": { "$ref": "#/$defs/recipient" },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 240 },
        "passport_ref": { "$ref": "#/$defs/passportReference" },
        "delivery_ref": { "$ref": "#/$defs/deliveryReference" },
        "valid_from": { "$ref": "#/$defs/instant" },
        "expires_at": { "$ref": "#/$defs/instant" },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time_limited", "bearer_secret_included", "identity_authenticated", "export_authorization_verified", "passport_status_mutated", "certification_issued"],
          "properties": {
            "time_limited": { "const": true },
            "bearer_secret_included": { "const": false },
            "identity_authenticated": { "const": false },
            "export_authorization_verified": { "const": false },
            "passport_status_mutated": { "const": false },
            "certification_issued": { "const": false }
          }
        },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "shareRevocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "event_id", "sequence", "tenant_id", "share_ref",
        "passport_ref", "occurred_at", "reason_code", "reason_detail", "actor", "boundary",
        "content_fingerprint"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "passport_share_revocation" },
        "event_id": { "$ref": "#/$defs/id" },
        "sequence": { "const": 1 },
        "tenant_id": { "$ref": "#/$defs/id" },
        "share_ref": { "$ref": "#/$defs/shareReference" },
        "passport_ref": { "$ref": "#/$defs/passportReference" },
        "occurred_at": { "$ref": "#/$defs/instant" },
        "reason_code": { "enum": ["publisher-revoked", "recipient-requested", "authorization-withdrawn", "delivery-withdrawn"] },
        "reason_detail": { "type": "string", "minLength": 3, "maxLength": 500 },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_id", "actor_role"],
          "properties": {
            "actor_id": { "$ref": "#/$defs/id" },
            "actor_role": { "enum": ["publisher", "operator"] }
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["append_only", "grant_mutated", "passport_status_mutated", "certification_issued"],
          "properties": {
            "append_only": { "const": true },
            "grant_mutated": { "const": false },
            "passport_status_mutated": { "const": false },
            "certification_issued": { "const": false }
          }
        },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "supplementRequestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "category", "description"],
      "properties": {
        "item_id": { "$ref": "#/$defs/id" },
        "category": { "enum": ["method-detail", "environment-detail", "source-lineage", "exclusion-rationale", "authorization-context", "other"] },
        "description": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    },
    "supplementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "request_id", "version", "tenant_id", "share_ref",
        "passport_ref", "requested_by", "requested_at", "items", "boundary", "content_fingerprint"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "passport_supplement_request" },
        "request_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "share_ref": { "$ref": "#/$defs/shareReference" },
        "passport_ref": { "$ref": "#/$defs/passportReference" },
        "requested_by": { "$ref": "#/$defs/id" },
        "requested_at": { "$ref": "#/$defs/instant" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/supplementRequestItem" }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_record_only", "raw_evidence_included", "passport_status_mutated", "certification_issued"],
          "properties": {
            "request_record_only": { "const": true },
            "raw_evidence_included": { "const": false },
            "passport_status_mutated": { "const": false },
            "certification_issued": { "const": false }
          }
        },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "supplementResponseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "disposition", "artifact_ref", "note"],
      "properties": {
        "item_id": { "$ref": "#/$defs/id" },
        "disposition": { "enum": ["provided", "unavailable"] },
        "artifact_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/artifactReference" }
          ]
        },
        "note": { "type": "string", "minLength": 3, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "provided" } } },
          "then": { "properties": { "artifact_ref": { "$ref": "#/$defs/artifactReference" } } },
          "else": { "properties": { "artifact_ref": { "type": "null" } } }
        }
      ]
    },
    "supplementResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "response_id", "version", "tenant_id", "request_ref",
        "share_ref", "passport_ref", "responded_by", "responder_role", "responded_at", "items",
        "boundary", "content_fingerprint"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "passport_supplement_response" },
        "response_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "request_ref": { "$ref": "#/$defs/requestReference" },
        "share_ref": { "$ref": "#/$defs/shareReference" },
        "passport_ref": { "$ref": "#/$defs/passportReference" },
        "responded_by": { "$ref": "#/$defs/id" },
        "responder_role": { "enum": ["publisher", "operator"] },
        "responded_at": { "$ref": "#/$defs/instant" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/supplementResponseItem" }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_closed", "raw_artifact_content_included", "passport_status_mutated", "independent_review_verified", "certification_issued"],
          "properties": {
            "request_closed": { "const": true },
            "raw_artifact_content_included": { "const": false },
            "passport_status_mutated": { "const": false },
            "independent_review_verified": { "const": false },
            "certification_issued": { "const": false }
          }
        },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "shareSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["share_ref", "evaluated_at", "share_state", "active", "expires_at"],
      "properties": {
        "share_ref": { "$ref": "#/$defs/shareReference" },
        "evaluated_at": { "$ref": "#/$defs/instant" },
        "share_state": { "const": "active" },
        "active": { "const": true },
        "expires_at": { "$ref": "#/$defs/instant" }
      }
    },
    "evidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passport_ref", "evaluated_at", "lifecycle_state", "active", "valid_until", "status_axes"],
      "properties": {
        "passport_ref": { "$ref": "#/$defs/passportReference" },
        "evaluated_at": { "$ref": "#/$defs/instant" },
        "lifecycle_state": { "const": "sealed" },
        "active": { "const": true },
        "valid_until": { "$ref": "#/$defs/instant" },
        "status_axes": { "$ref": "#/$defs/statusAxes" }
      }
    },
    "buyerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "decision_id", "version", "tenant_id", "share_ref",
        "passport_ref", "buyer_id", "decided_at", "decision", "reason_codes", "decision_note",
        "supplement_request_refs", "supplement_response_refs", "share_snapshot",
        "platform_evidence_snapshot", "boundary", "content_fingerprint"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "passport_buyer_decision" },
        "decision_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "share_ref": { "$ref": "#/$defs/shareReference" },
        "passport_ref": { "$ref": "#/$defs/passportReference" },
        "buyer_id": { "$ref": "#/$defs/id" },
        "decided_at": { "$ref": "#/$defs/instant" },
        "decision": { "enum": ["accepted", "rejected"] },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "evidence-sufficient", "supplement-satisfied", "commercial-fit", "evidence-insufficient",
              "scope-mismatch", "risk-unaccepted", "commercial-mismatch", "other"
            ]
          }
        },
        "decision_note": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "supplement_request_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requestReference" }
        },
        "supplement_response_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/responseReference" }
        },
        "share_snapshot": { "$ref": "#/$defs/shareSnapshot" },
        "platform_evidence_snapshot": { "$ref": "#/$defs/evidenceSnapshot" },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buyer_decision_only", "platform_evidence_status_mutated", "independent_review_status_changed",
            "freshness_status_changed", "policy_decision_status_changed", "performance_claim_allowed",
            "certification_issued"
          ],
          "properties": {
            "buyer_decision_only": { "const": true },
            "platform_evidence_status_mutated": { "const": false },
            "independent_review_status_changed": { "const": false },
            "freshness_status_changed": { "const": false },
            "policy_decision_status_changed": { "const": false },
            "performance_claim_allowed": { "const": false },
            "certification_issued": { "const": false }
          }
        },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "accepted" } } },
          "then": {
            "properties": {
              "reason_codes": {
                "items": { "enum": ["evidence-sufficient", "supplement-satisfied", "commercial-fit", "other"] }
              }
            }
          },
          "else": {
            "properties": {
              "reason_codes": {
                "items": { "enum": ["evidence-insufficient", "scope-mismatch", "risk-unaccepted", "commercial-mismatch", "other"] }
              }
            }
          }
        }
      ]
    }
  }
}
