{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/passport/passport-delivery-manifest-v1.schema.json",
  "title": "CT-AIComm Link Evidence Passport delivery manifest v1",
  "description": "Checksum-bound manifest for JSON, source CSV, a reproducible human summary, and offline verification instructions. Validation is not authentication, export authorization, independent review, a performance claim, or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "delivery_id",
    "version",
    "tenant_id",
    "created_at",
    "passport_ref",
    "run_ref",
    "freeze_ref",
    "data_origins",
    "statistics_profile",
    "summary",
    "artifacts",
    "verification",
    "boundary",
    "content_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "passport_delivery_manifest" },
    "delivery_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/instant" },
    "passport_ref": { "$ref": "#/$defs/passportReference" },
    "run_ref": { "$ref": "#/$defs/runReference" },
    "freeze_ref": { "$ref": "#/$defs/freezeReference" },
    "data_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["measured", "synthetic", "inferred", "declared"] }
    },
    "statistics_profile": { "$ref": "#/$defs/statisticsProfile" },
    "summary": { "$ref": "#/$defs/summary" },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "verification": { "$ref": "#/$defs/verification" },
    "boundary": { "$ref": "#/$defs/boundary" },
    "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "referenceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id", "content_fingerprint"],
      "properties": {
        "object_type": { "type": "string" },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "passportReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_evidence_version" } } }
      ]
    },
    "runReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "run" } } }
      ]
    },
    "freezeReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_scenario_method_freeze" } } }
      ]
    },
    "observationReference": {
      "allOf": [
        { "$ref": "#/$defs/referenceBase" },
        { "properties": { "object_type": { "const": "passport_normalized_observation" } } }
      ]
    },
    "statisticsProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "numeric_model", "percentile_method", "sample_order", "unit_catalog"],
      "properties": {
        "profile_id": { "const": "ct-passport-statistics-v1" },
        "profile_version": { "const": "1.0.0" },
        "numeric_model": { "const": "IEEE-754-binary64-15-significant-digits" },
        "percentile_method": { "const": "nearest-rank" },
        "sample_order": { "const": "observation-id-sequence-sample-id" },
        "unit_catalog": { "const": "ct-passport-observation-unit-rules-v1" }
      }
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_ref",
        "data_origin",
        "observation_point",
        "metric",
        "aggregation",
        "source_unit",
        "normalized_unit",
        "attempted_samples",
        "included_samples",
        "failed_samples",
        "excluded_samples",
        "reported_value",
        "recomputed_value",
        "exact_match"
      ],
      "properties": {
        "observation_ref": { "$ref": "#/$defs/observationReference" },
        "data_origin": { "enum": ["measured", "synthetic", "inferred", "declared"] },
        "observation_point": { "type": "string", "minLength": 1, "maxLength": 120 },
        "metric": { "type": "string", "minLength": 1, "maxLength": 96 },
        "aggregation": { "enum": ["raw", "count", "mean", "min", "max", "p50", "p95", "p99"] },
        "source_unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "normalized_unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "attempted_samples": { "type": "integer", "minimum": 1 },
        "included_samples": { "type": "integer", "minimum": 0 },
        "failed_samples": { "type": "integer", "minimum": 0 },
        "excluded_samples": { "type": "integer", "minimum": 0 },
        "reported_value": { "type": ["number", "null"], "minimum": 0 },
        "recomputed_value": { "type": ["number", "null"], "minimum": 0 },
        "exact_match": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_count", "sample_count", "statistic_count", "all_statistics_exact", "statistics"],
      "properties": {
        "observation_count": { "type": "integer", "minimum": 1 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "statistic_count": { "type": "integer", "minimum": 1 },
        "all_statistics_exact": { "const": true },
        "statistics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/statistic" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "role", "sha256", "bytes"],
      "properties": {
        "path": {
          "enum": [
            "VERIFY.md",
            "SUMMARY.md",
            "freeze.json",
            "observations.json",
            "passport-version.json",
            "previous-version.json",
            "run.json",
            "samples.csv"
          ]
        },
        "media_type": { "enum": ["application/json", "text/csv", "text/markdown"] },
        "role": {
          "enum": [
            "offline-verification-instructions",
            "human-readable-summary",
            "scenario-method-freeze",
            "normalized-observations",
            "sealed-passport-version",
            "previous-passport-version",
            "started-run-binding",
            "source-samples"
          ]
        },
        "sha256": { "$ref": "#/$defs/fingerprint" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "minimum_node_version", "external_network_required", "credentials_required"],
      "properties": {
        "command": { "const": "node scripts/verify-passport-delivery.mjs <delivery-directory>" },
        "minimum_node_version": { "const": "22" },
        "external_network_required": { "const": false },
        "credentials_required": { "const": false }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_integrity_only",
        "statistics_recomputed",
        "human_summary_recomputed",
        "principal_authentication_verified",
        "export_authorization_verified",
        "independent_review_verified",
        "performance_claim_allowed",
        "certification_issued"
      ],
      "properties": {
        "content_integrity_only": { "const": true },
        "statistics_recomputed": { "const": true },
        "human_summary_recomputed": { "const": true },
        "principal_authentication_verified": { "const": false },
        "export_authorization_verified": { "const": false },
        "independent_review_verified": { "const": false },
        "performance_claim_allowed": { "const": false },
        "certification_issued": { "const": false }
      }
    }
  }
}
