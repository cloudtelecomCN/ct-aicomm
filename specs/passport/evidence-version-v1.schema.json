{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/passport/evidence-version-v1.schema.json",
  "title": "CT-AIComm Link Evidence Passport sealed evidence version v1",
  "description": "An immutable, origin-separated passport version with exact content references and version-local review and freshness seeds. Conformance does not establish authenticity, independent review, policy acceptance, performance, or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "passport_id",
    "version",
    "tenant_id",
    "created_by",
    "created_at",
    "authorization_scope",
    "sealed_at",
    "freshness_ttl_seconds",
    "valid_until",
    "supersedes_ref",
    "freeze_ref",
    "run_ref",
    "observation_sets",
    "status_seed",
    "boundary",
    "content_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "passport_evidence_version" },
    "passport_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "created_by": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/instant" },
    "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
    "sealed_at": { "$ref": "#/$defs/instant" },
    "freshness_ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 31536000 },
    "valid_until": { "$ref": "#/$defs/instant" },
    "supersedes_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/passportReference" }
      ]
    },
    "freeze_ref": {
      "allOf": [
        { "$ref": "#/$defs/contentReference" },
        { "properties": { "object_type": { "const": "passport_scenario_method_freeze" } } }
      ]
    },
    "run_ref": {
      "allOf": [
        { "$ref": "#/$defs/contentReference" },
        { "properties": { "object_type": { "const": "run" } } }
      ]
    },
    "observation_sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "observation_refs"],
        "properties": {
          "origin": { "enum": ["measured", "synthetic", "inferred", "declared"] },
          "observation_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/contentReference" },
                { "properties": { "object_type": { "const": "observation" } } }
              ]
            }
          }
        }
      }
    },
    "status_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_validity", "content_integrity", "independent_review", "freshness", "policy_decision"],
      "properties": {
        "measurement_validity": { "enum": ["sufficient", "partial", "invalid", "unknown"] },
        "content_integrity": { "const": "passed" },
        "independent_review": { "const": "not-reviewed" },
        "freshness": { "const": "valid" },
        "policy_decision": { "const": "manual-review" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "origin_separated", "review_inherited", "freshness_inherited", "performance_claim_allowed", "certification_issued"],
      "properties": {
        "immutable": { "const": true },
        "origin_separated": { "const": true },
        "review_inherited": { "const": false },
        "freshness_inherited": { "const": false },
        "performance_claim_allowed": { "const": false },
        "certification_issued": { "const": false }
      }
    },
    "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "authorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "purpose", "recipients", "expires_at"],
      "properties": {
        "visibility": { "enum": ["private", "shared", "public"] },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 240 },
        "recipients": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "expires_at": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/instant" }
          ]
        }
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id", "content_fingerprint"],
      "properties": {
        "object_type": { "enum": ["run", "passport_scenario_method_freeze", "observation"] },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "passportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id", "content_fingerprint"],
      "properties": {
        "object_type": { "const": "passport_evidence_version" },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" },
        "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
