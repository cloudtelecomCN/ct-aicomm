{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/passport/scenario-method-freeze-v1.schema.json",
  "title": "CT-AIComm link evidence passport scenario and method freeze v1",
  "description": "Immutable site, direction, protocol, workload, and method-template contract. A valid freeze is not measurement evidence, execution authorization, independent review, or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "freeze_id",
    "version",
    "tenant_id",
    "created_by",
    "created_at",
    "authorization_scope",
    "scope_ref",
    "method_ref",
    "scenario",
    "method_template",
    "boundary",
    "content_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "passport_scenario_method_freeze" },
    "freeze_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "created_by": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/instant" },
    "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
    "scope_ref": { "$ref": "#/$defs/scopeReference" },
    "method_ref": { "$ref": "#/$defs/methodReference" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "method_template": { "$ref": "#/$defs/methodTemplate" },
    "boundary": { "$ref": "#/$defs/boundary" },
    "content_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "exactLabelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "not": { "pattern": "^[Ll][Aa][Tt][Ee][Ss][Tt]$" }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "authorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "purpose", "recipients", "expires_at"],
      "properties": {
        "visibility": { "enum": ["private", "shared", "public"] },
        "purpose": { "type": "string", "minLength": 3, "maxLength": 240 },
        "recipients": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "expires_at": {
          "oneOf": [
            { "$ref": "#/$defs/instant" },
            { "type": "null" }
          ]
        }
      }
    },
    "scopeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id"],
      "properties": {
        "object_type": { "const": "scope" },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" }
      }
    },
    "methodReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id", "version", "tenant_id"],
      "properties": {
        "object_type": { "const": "method" },
        "object_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tenant_id": { "$ref": "#/$defs/id" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "role", "region"],
      "properties": {
        "site_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["source", "destination"] },
        "region": { "type": "string", "minLength": 2, "maxLength": 96 }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "version", "profile"],
      "properties": {
        "protocol_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/exactLabelVersion" },
        "profile": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_class", "name", "version", "origin", "configuration_fingerprint"],
      "properties": {
        "workload_class": { "enum": ["network-transfer", "inference", "training", "other"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "$ref": "#/$defs/exactLabelVersion" },
        "origin": { "enum": ["synthetic", "production-like", "production"] },
        "configuration_fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sites", "direction", "protocol", "workload"],
      "properties": {
        "sites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/site" }
        },
        "direction": { "enum": ["unidirectional", "bidirectional"] },
        "protocol": { "$ref": "#/$defs/protocol" },
        "workload": { "$ref": "#/$defs/workload" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "value": { "type": ["string", "number", "boolean"] },
        "unit": { "type": ["string", "null"], "maxLength": 48 }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_count", "interval_ms", "warmup_count"],
      "properties": {
        "target_count": { "type": "integer", "minimum": 1 },
        "interval_ms": { "type": "integer", "minimum": 0 },
        "warmup_count": { "type": "integer", "minimum": 0 }
      }
    },
    "exclusionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "description"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "aggregations"],
      "properties": {
        "metric": { "type": "string", "minLength": 1, "maxLength": 96 },
        "aggregations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["raw", "count", "mean", "min", "max", "p50", "p95", "p99"] }
        }
      }
    },
    "methodTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "version", "tool", "parameters", "sampling", "exclusion_rules", "statistics", "environment_prerequisites"],
      "properties": {
        "template_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "artifact_fingerprint"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "version": { "$ref": "#/$defs/exactLabelVersion" },
            "artifact_fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "sampling": { "$ref": "#/$defs/sampling" },
        "exclusion_rules": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/exclusionRule" }
        },
        "statistics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/statistic" }
        },
        "environment_prerequisites": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_origin", "limitations", "performance_claim_allowed"],
      "properties": {
        "data_origin": { "enum": ["synthetic", "hybrid", "measured"] },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 500 }
        },
        "performance_claim_allowed": { "const": false }
      }
    }
  }
}
