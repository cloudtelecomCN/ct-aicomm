{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/compliance/data-path-declaration-v1.json",
  "title": "CT-AIComm data path declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "declaration_id",
    "tenant_id",
    "workload_id",
    "revision",
    "data_origin",
    "declared_at",
    "data_categories",
    "ordered_region_ids",
    "regions",
    "boundaries",
    "encryption",
    "processors",
    "declaration_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "declaration_id": { "$ref": "#/$defs/id" },
    "tenant_id": { "$ref": "#/$defs/id" },
    "workload_id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "data_origin": { "enum": ["declared", "synthetic"] },
    "declared_at": { "type": "string", "format": "date-time" },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/data_category" }
    },
    "ordered_region_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "regions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/region" }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundary" }
    },
    "encryption": { "$ref": "#/$defs/encryption" },
    "processors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/processor" }
    },
    "declaration_fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$"
    },
    "data_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "classification"],
      "properties": {
        "category_id": { "$ref": "#/$defs/id" },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "jurisdiction_code", "provider", "provider_region", "roles"],
      "properties": {
        "region_id": { "$ref": "#/$defs/id" },
        "jurisdiction_code": { "$ref": "#/$defs/jurisdiction" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "provider_region": { "$ref": "#/$defs/id" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["origin", "transit", "processing", "storage", "destination"] }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "from_region_id", "to_region_id", "boundary_types", "cross_jurisdiction", "transfer_basis_ref"],
      "properties": {
        "boundary_id": { "$ref": "#/$defs/id" },
        "from_region_id": { "$ref": "#/$defs/id" },
        "to_region_id": { "$ref": "#/$defs/id" },
        "boundary_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["network_zone", "tenant", "provider", "jurisdiction"] }
        },
        "cross_jurisdiction": { "type": "boolean" },
        "transfer_basis_ref": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "cross_jurisdiction": { "const": true } },
            "required": ["cross_jurisdiction"]
          },
          "then": {
            "properties": {
              "boundary_types": { "contains": { "const": "jurisdiction" } },
              "transfer_basis_ref": { "$ref": "#/$defs/id" }
            }
          },
          "else": {
            "properties": {
              "boundary_types": { "not": { "contains": { "const": "jurisdiction" } } },
              "transfer_basis_ref": { "type": "null" }
            }
          }
        }
      ]
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_transit", "at_rest"],
      "properties": {
        "in_transit": { "$ref": "#/$defs/in_transit" },
        "at_rest": { "$ref": "#/$defs/at_rest" }
      }
    },
    "in_transit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "protocols", "termination", "plaintext_exception_refs"],
      "properties": {
        "required": { "type": "boolean" },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["tls-1.2", "tls-1.3", "mtls-1.2", "mtls-1.3", "ipsec", "wireguard", "macsec", "application-layer"] }
        },
        "termination": { "enum": ["end-to-end", "boundary", "hop-by-hop", "not-applicable"] },
        "plaintext_exception_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": {
            "properties": {
              "protocols": { "minItems": 1 },
              "termination": { "not": { "const": "not-applicable" } }
            }
          },
          "else": {
            "properties": {
              "protocols": { "maxItems": 0 },
              "termination": { "const": "not-applicable" }
            }
          }
        }
      ]
    },
    "at_rest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "algorithms", "key_control", "key_reference"],
      "properties": {
        "required": { "type": "boolean" },
        "algorithms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["aes-128-gcm", "aes-256-gcm", "aes-256-xts", "provider-managed"] }
        },
        "key_control": { "enum": ["tenant", "processor", "shared", "not-applicable"] },
        "key_reference": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": {
            "properties": {
              "algorithms": { "minItems": 1 },
              "key_control": { "not": { "const": "not-applicable" } },
              "key_reference": { "$ref": "#/$defs/id" }
            }
          },
          "else": {
            "properties": {
              "algorithms": { "maxItems": 0 },
              "key_control": { "const": "not-applicable" },
              "key_reference": { "type": "null" }
            }
          }
        }
      ]
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processor_id", "legal_name", "role", "purposes", "data_category_ids", "region_ids", "parent_processor_id", "agreement_ref"],
      "properties": {
        "processor_id": { "$ref": "#/$defs/id" },
        "legal_name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "role": { "enum": ["controller", "processor", "subprocessor"] },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "data_category_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "region_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "parent_processor_id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "agreement_ref": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "subprocessor" } }, "required": ["role"] },
          "then": { "properties": { "parent_processor_id": { "$ref": "#/$defs/id" } } },
          "else": { "properties": { "parent_processor_id": { "type": "null" } } }
        }
      ]
    }
  }
}
