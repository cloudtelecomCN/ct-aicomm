{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/combination-comparison-v1.schema.json",
  "title": "CT-Advisor Combination Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "builder_version", "generated_at", "dimension_order", "rows", "comparability", "duplicates", "boundaries", "comparison_sha256"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "builder_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "dimension_order": { "type": "array", "minItems": 19, "maxItems": 19, "uniqueItems": true, "items": { "type": "string" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["combination_id", "combination_key", "display_name", "status", "dimensions", "combination_signature_sha256", "content_sha256"],
        "properties": {
          "combination_id": { "type": "string", "pattern": "^advisor_combination_[0-9a-f-]{36}$" },
          "combination_key": { "type": "string" },
          "display_name": { "type": "string" },
          "status": { "enum": ["comparable", "needs_review", "blocked"] },
          "dimensions": { "type": "object", "minProperties": 19, "maxProperties": 19, "additionalProperties": { "$ref": "infrastructure-combination-v1.schema.json#/$defs/dimension" } },
          "combination_signature_sha256": { "$ref": "infrastructure-combination-v1.schema.json#/$defs/sha256" },
          "content_sha256": { "$ref": "infrastructure-combination-v1.schema.json#/$defs/sha256" }
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "combination_count", "comparable_combination_count", "blocked_combination_ids", "unknown_dimensions", "reason_codes"],
      "properties": {
        "status": { "enum": ["comparable", "partial", "blocked"] },
        "combination_count": { "type": "integer", "minimum": 1 },
        "comparable_combination_count": { "type": "integer", "minimum": 0 },
        "blocked_combination_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "unknown_dimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "combination_id", "conflicts_with", "combination_key"],
        "properties": {
          "code": { "enum": ["duplicate_combination_key", "duplicate_combination_signature"] },
          "combination_id": { "type": "string" },
          "conflicts_with": { "type": "string" },
          "combination_key": { "type": "string" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side_by_side_only", "constraints_applied", "scoring_applied", "ranking_applied", "recommendation_issued", "execution_authorized"],
      "properties": {
        "side_by_side_only": { "const": true },
        "constraints_applied": { "const": false },
        "scoring_applied": { "const": false },
        "ranking_applied": { "const": false },
        "recommendation_issued": { "const": false },
        "execution_authorized": { "const": false }
      }
    },
    "comparison_sha256": { "$ref": "infrastructure-combination-v1.schema.json#/$defs/sha256" }
  }
}
