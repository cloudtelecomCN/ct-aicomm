{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/task-template-registry-v1.schema.json",
  "title": "CT-Advisor task template registry v1",
  "description": "Versioned public task catalog with bilingual maturity, enablement, free-access, and decision-support boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_version", "published_at", "maturity_levels", "templates"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry_id": { "const": "ct-advisor-task-templates" },
    "registry_version": { "const": "1.0.0" },
    "published_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "maturity_levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/previewMaturity" },
        { "$ref": "#/$defs/betaMaturity" },
        { "$ref": "#/$defs/stableMaturity" }
      ],
      "items": false
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["template_id", "package_eligible"],
        "properties": {
          "template_id": { "const": "ai-inference-infrastructure-selection/v1" },
          "package_eligible": { "const": true }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": { "$ref": "#/$defs/taskTemplate" }
    }
  },
  "$defs": {
    "maturityBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_zh", "name_en", "meaning_zh", "meaning_en"],
      "properties": {
        "id": { "enum": ["preview", "beta", "stable"] },
        "name_zh": { "type": "string", "minLength": 1 },
        "name_en": { "type": "string", "minLength": 1 },
        "meaning_zh": { "type": "string", "minLength": 10 },
        "meaning_en": { "type": "string", "minLength": 10 }
      }
    },
    "previewMaturity": {
      "allOf": [
        { "$ref": "#/$defs/maturityBase" },
        { "properties": { "id": { "const": "preview" } } }
      ]
    },
    "betaMaturity": {
      "allOf": [
        { "$ref": "#/$defs/maturityBase" },
        { "properties": { "id": { "const": "beta" } } }
      ]
    },
    "stableMaturity": {
      "allOf": [
        { "$ref": "#/$defs/maturityBase" },
        { "properties": { "id": { "const": "stable" } } }
      ]
    },
    "taskTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "template_key",
        "version",
        "title_zh",
        "title_en",
        "summary_zh",
        "summary_en",
        "maturity",
        "default_enabled",
        "enabled",
        "state_reason",
        "access",
        "package_eligible",
        "execution_mode",
        "capability_tags",
        "fixture_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "package_eligible": { "const": true } },
            "required": ["package_eligible"]
          },
          "then": {
            "properties": { "template_id": { "const": "ai-inference-infrastructure-selection/v1" } }
          }
        },
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "state_reason": { "const": "published" } }
          },
          "else": {
            "properties": { "state_reason": { "enum": ["operator_disabled", "retired", "dependency_unavailable"] } }
          }
        }
      ],
      "properties": {
        "template_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/v[1-9][0-9]*$" },
        "template_key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "title_zh": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "summary_zh": { "type": "string", "minLength": 10 },
        "summary_en": { "type": "string", "minLength": 10 },
        "maturity": { "enum": ["preview", "beta", "stable"] },
        "default_enabled": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "state_reason": { "enum": ["published", "operator_disabled", "retired", "dependency_unavailable"] },
        "access": { "const": "free" },
        "package_eligible": { "type": "boolean" },
        "execution_mode": { "const": "decision_support_only" },
        "capability_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "fixture_id": { "type": "string", "pattern": "^fixture-[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$" }
      }
    }
  }
}
