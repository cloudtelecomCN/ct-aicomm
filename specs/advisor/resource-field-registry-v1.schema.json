{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/resource-field-registry-v1.schema.json",
  "title": "CT-Advisor resource field registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_version", "published_at", "units", "source_kinds", "confidence_levels", "authorization_bases", "authorization_decisions", "resource_types", "fields", "resource_profiles"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry_id": { "const": "ct-advisor-resource-fields" },
    "registry_version": { "const": "1.0.0" },
    "published_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "units": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/unit" } },
    "source_kinds": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["measured", "vendor_published", "customer_quoted", "customer_declared", "modeled", "inferred", "synthetic", "unknown"] } },
    "confidence_levels": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["high", "medium", "low", "unknown"] } },
    "authorization_bases": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["public_web", "open_license", "customer_authorized", "contract", "internal_synthetic", "unknown"] } },
    "authorization_decisions": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["allowed", "prohibited", "unknown"] } },
    "resource_types": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["gpu", "cloud_instance", "region", "network_path", "software_stack", "pricing_offer"] } },
    "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
    "resource_profiles": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "symbol", "quantity_zh", "quantity_en"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "symbol": { "type": "string", "minLength": 1 },
        "quantity_zh": { "type": "string", "minLength": 1 },
        "quantity_en": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "resource_type", "label_zh", "label_en", "description_zh", "description_en", "value_type", "allowed_units"],
      "properties": {
        "field_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" },
        "resource_type": { "enum": ["gpu", "cloud_instance", "region", "network_path", "software_stack", "pricing_offer"] },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "description_zh": { "type": "string", "minLength": 8 },
        "description_en": { "type": "string", "minLength": 8 },
        "value_type": { "enum": ["string", "number", "integer", "boolean", "string_list"] },
        "allowed_units": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "field_set_version", "required_fields", "optional_fields"],
      "properties": {
        "resource_type": { "enum": ["gpu", "cloud_instance", "region", "network_path", "software_stack", "pricing_offer"] },
        "field_set_version": { "const": "1.0.0" },
        "required_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" } },
        "optional_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" } }
      }
    }
  }
}
