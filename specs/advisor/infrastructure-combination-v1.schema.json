{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/infrastructure-combination-v1.schema.json",
  "title": "CT-Advisor Infrastructure Combination v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "builder_version", "combination_id", "combination_key", "display_name",
    "source_mode", "import_row_ref", "resource_refs", "configuration", "resolved_resources",
    "status", "conflicts", "comparison_dimensions", "input_sha256", "combination_signature_sha256",
    "evaluated_at", "created_at", "boundaries", "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "builder_version": { "const": "1.0.0" },
    "combination_id": { "type": "string", "pattern": "^advisor_combination_[0-9a-f-]{36}$" },
    "combination_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 180 },
    "source_mode": { "enum": ["manual", "json_import", "csv_import", "rule_generated"] },
    "import_row_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
    "resource_refs": { "$ref": "infrastructure-combination-input-v1.schema.json#/properties/resource_refs" },
    "configuration": { "$ref": "infrastructure-combination-input-v1.schema.json#/properties/configuration" },
    "resolved_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "resource_type", "canonical_key", "display_name", "data_class", "lifecycle_status", "freshness", "source_kind", "source_snapshot_sha256", "resource_sha256"],
        "properties": {
          "resource_id": { "$ref": "infrastructure-combination-input-v1.schema.json#/$defs/resourceId" },
          "resource_type": { "enum": ["gpu", "cloud_instance", "region", "network_path", "software_stack", "pricing_offer"] },
          "canonical_key": { "type": "string", "minLength": 3, "maxLength": 160 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 180 },
          "data_class": { "enum": ["public", "tenant_private", "synthetic"] },
          "lifecycle_status": { "enum": ["active", "deprecated", "unknown"] },
          "freshness": { "enum": ["current", "not_yet_effective", "expired"] },
          "source_kind": { "type": "string", "minLength": 1, "maxLength": 40 },
          "source_snapshot_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "resource_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "status": { "enum": ["comparable", "needs_review", "blocked"] },
    "conflicts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "field", "resource_refs", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$" },
          "severity": { "enum": ["error", "warning"] },
          "field": { "type": "string", "minLength": 1, "maxLength": 160 },
          "resource_refs": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "comparison_dimensions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dimension" },
      "minProperties": 19,
      "maxProperties": 19
    },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "combination_signature_sha256": { "$ref": "#/$defs/sha256" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_support_only", "execution_authorized", "constraint_evaluation_performed", "ranking_performed", "performance_claim_allowed"],
      "properties": {
        "decision_support_only": { "const": true },
        "execution_authorized": { "const": false },
        "constraint_evaluation_performed": { "const": false },
        "ranking_performed": { "const": false },
        "performance_claim_allowed": { "const": false }
      }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit"],
      "properties": {
        "status": { "enum": ["provided", "unknown"] },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "array", "items": { "type": "string" } },
            { "type": "null" }
          ]
        },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
