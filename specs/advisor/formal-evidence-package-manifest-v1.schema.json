{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/formal-evidence-package-manifest-v1.schema.json",
  "title": "CT-Advisor GPU Decision & Evidence Package Manifest v1",
  "description": "Frozen forward contract for CT-668. CT-666 does not issue or assemble packages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "profile_id", "profile_version", "package_id", "package_revision", "contract_id", "capability_key", "locale", "state", "created_at", "source_bindings", "delivery_items", "checksum_manifest", "compatibility", "boundaries", "content_sha256"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_type": { "const": "ct_advisor_gpu_decision_evidence_package_manifest" },
    "profile_id": { "const": "ct-advisor-gpu-decision-evidence-package/v1" },
    "profile_version": { "const": "1.0.0" },
    "package_id": { "type": "string", "pattern": "^advisor_evidence_package_[0-9a-f-]{36}$" },
    "package_revision": { "type": "integer", "minimum": 1 },
    "contract_id": { "type": "string", "pattern": "^advisor_package_contract_[0-9a-f-]{36}$" },
    "capability_key": { "const": "gpu_preprocurement_decision_evidence_package" },
    "locale": { "enum": ["en", "zh-CN"] },
    "state": { "enum": ["assembled", "issued", "accepted", "superseded", "revoked"] },
    "created_at": { "type": "string", "format": "date-time" },
    "source_bindings": { "$ref": "formal-evidence-package-contract-v1.schema.json#/$defs/sourceBindings" },
    "delivery_items": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        { "$ref": "#/$defs/D01" }, { "$ref": "#/$defs/D02" }, { "$ref": "#/$defs/D03" },
        { "$ref": "#/$defs/D04" }, { "$ref": "#/$defs/D05" }, { "$ref": "#/$defs/D06" },
        { "$ref": "#/$defs/D07" }, { "$ref": "#/$defs/D08" }, { "$ref": "#/$defs/D09" },
        { "$ref": "#/$defs/D10" }, { "$ref": "#/$defs/D11" }, { "$ref": "#/$defs/D12" },
        { "$ref": "#/$defs/D13" }
      ],
      "items": false
    },
    "checksum_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "algorithm", "covers_exact_delivered_bytes", "archive_digest_sidecar_required"],
      "properties": {
        "path": { "const": "SHA256SUMS" },
        "algorithm": { "const": "SHA-256" },
        "covers_exact_delivered_bytes": { "const": true },
        "archive_digest_sidecar_required": { "const": true }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "minimum_verifier_version", "unknown_field_policy"],
      "properties": {
        "policy_id": { "const": "ct-advisor-evidence-package-strict-semver-v1" },
        "minimum_verifier_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "unknown_field_policy": { "const": "reject" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_authorized", "certification_issued", "legal_opinion_issued", "performance_claim_allowed"],
      "properties": {
        "execution_authorized": { "const": false },
        "certification_issued": { "const": false },
        "legal_opinion_issued": { "const": false },
        "performance_claim_allowed": { "const": false }
      }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
        "format": { "enum": ["pdf", "docx", "xlsx", "csv", "json", "zip", "txt", "html", "markdown"] },
        "media_type": { "type": "string", "minLength": 3, "maxLength": 120 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "payloadItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "artifact_key", "delivery_status", "files"],
      "properties": {
        "item_id": { "type": "string" },
        "artifact_key": { "type": "string" },
        "delivery_status": { "const": "included" },
        "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "containerItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "artifact_key", "delivery_status", "files", "container_semantics"],
      "properties": {
        "item_id": { "const": "D10" },
        "artifact_key": { "const": "evidence_package_container" },
        "delivery_status": { "const": "aggregate" },
        "files": { "type": "array", "maxItems": 0 },
        "container_semantics": { "const": "this_manifest_describes_the_archive_the_archive_digest_is_an_external_sidecar" }
      }
    },
    "D01": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D01" }, "artifact_key": { "const": "scope_and_responsibility_boundary" } } }] },
    "D02": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D02" }, "artifact_key": { "const": "requirement_passport" } } }] },
    "D03": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D03" }, "artifact_key": { "const": "candidate_and_combination_matrix" } } }] },
    "D04": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D04" }, "artifact_key": { "const": "source_ledger_and_gap_register" } } }] },
    "D05": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D05" }, "artifact_key": { "const": "infrastructure_risk_analysis" } } }] },
    "D06": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D06" }, "artifact_key": { "const": "scenario_pareto_sensitivity_results" } } }] },
    "D07": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D07" }, "artifact_key": { "const": "gpu_decision_report" } } }] },
    "D08": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D08" }, "artifact_key": { "const": "explainable_recommendation" } } }] },
    "D09": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D09" }, "artifact_key": { "const": "decision_and_approval_record" } } }] },
    "D10": { "$ref": "#/$defs/containerItem" },
    "D11": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D11" }, "artifact_key": { "const": "offline_verification_result" } } }] },
    "D12": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D12" }, "artifact_key": { "const": "raw_transformed_data_and_exit_package" } } }] },
    "D13": { "allOf": [{ "$ref": "#/$defs/payloadItem" }, { "properties": { "item_id": { "const": "D13" }, "artifact_key": { "const": "versioned_product_manual" } } }] }
  }
}
