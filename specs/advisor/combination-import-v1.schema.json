{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/combination-import-v1.schema.json",
  "title": "CT-Advisor Combination Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "payload"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "format": { "enum": ["json", "csv"] },
    "payload": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 2000000 },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "infrastructure-combination-input-v1.schema.json" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "combinations"],
          "properties": {
            "schema_version": { "const": "1.0.0" },
            "combinations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": { "$ref": "infrastructure-combination-input-v1.schema.json" }
            }
          }
        }
      ]
    }
  }
}
