{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/advisor/sizing-cost-result-v1.schema.json",
  "title": "CT-Advisor Sizing and Cost Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "formula_version", "input_sha256", "status", "sizing", "cost", "missing_inputs", "formulas", "calculation_sha256", "boundaries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "formula_version": { "const": "1.0.0" },
    "input_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "type": "string", "enum": ["complete", "partial", "insufficient"] },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metrics"],
      "properties": {
        "status": { "type": "string", "enum": ["computed", "partial"] },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currency", "metrics"],
      "properties": {
        "status": { "type": "string", "enum": ["computed", "partial", "not_requested"] },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } }
      }
    },
    "missing_inputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "formulas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "calculation_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate_only", "inventory_claim_allowed", "performance_claim_allowed", "execution_authorized", "missing_values_imputed"],
      "properties": {
        "estimate_only": { "const": true },
        "inventory_claim_allowed": { "const": false },
        "performance_claim_allowed": { "const": false },
        "execution_authorized": { "const": false },
        "missing_values_imputed": { "const": false }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit", "formula_id", "inputs", "missing_inputs"],
      "properties": {
        "status": { "type": "string", "enum": ["computed", "unknown"] },
        "value": { "oneOf": [{ "$ref": "#/$defs/range" }, { "type": "null" }] },
        "unit": { "type": "string" },
        "formula_id": { "type": "string" },
        "inputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "missing_inputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "computed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "value": { "$ref": "#/$defs/range" },
              "missing_inputs": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "value": { "type": "null" },
              "missing_inputs": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
