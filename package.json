{
  "name": "@cloudtelecom/ct-aicomm-open",
  "version": "0.2.0-open.1",
  "private": true,
  "description": "Public CT-AIComm specifications, integration contracts, conformance tools, and synthetic examples.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:boundary": "node scripts/check-public-boundary.mjs",
    "verify:example": "node cli/verify-evidence.mjs examples/synthetic/evidence-version.json",
    "test": "node scripts/check-public-boundary.mjs && node --test",
    "build:validator": "node scripts/build-evidence-validator.mjs",
    "check:validator": "node scripts/build-evidence-validator.mjs --check",
    "test:live-api": "node scripts/check-live-api.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.12",
    "yaml": "2.9.1"
  },
  "license": "Apache-2.0"
}
