{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/bench/environment-fingerprint.v2.json",
  "title": "CT-Bench environment fingerprint v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured_at", "host", "hardware", "kernel", "drivers", "runtimes", "inference_server", "model", "protocol_stack", "network", "artifacts"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "captured_at": { "type": "string", "format": "date-time" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname_hash", "os_distribution", "os_version", "machine_arch"],
      "properties": {
        "hostname_hash": { "$ref": "#/$defs/sha256" },
        "os_distribution": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string", "minLength": 1 },
        "machine_arch": { "type": "string", "minLength": 1 },
        "container_image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_model", "logical_cores", "memory_bytes", "accelerators"],
      "properties": {
        "cpu_model": { "type": "string", "minLength": 1 },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "numa_nodes": { "type": "integer", "minimum": 1 },
        "accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor", "model", "count", "memory_bytes_each"],
            "properties": {
              "vendor": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 },
              "memory_bytes_each": { "type": "integer", "minimum": 1 },
              "firmware_version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "command_line_sha256", "bpf_enabled"],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "command_line_sha256": { "$ref": "#/$defs/sha256" },
        "bpf_enabled": { "type": "boolean" },
        "btf_available": { "type": "boolean" }
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "module_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inference_server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "launch_config_sha256"],
      "properties": {
        "name": { "const": "vllm" },
        "version": { "type": "string", "pattern": "^0\\.\\d+\\.\\d+$" },
        "launch_config_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "revision", "artifact_sha256", "tokenizer_sha256"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "tokenizer_sha256": { "$ref": "#/$defs/sha256" },
        "quantization": { "type": ["string", "null"] }
      }
    },
    "protocol_stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "config_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "config_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "address_family", "interfaces", "route_table_sha256"],
      "properties": {
        "topology": { "type": "string", "minLength": 1 },
        "address_family": { "enum": ["ipv4", "ipv6", "dual"] },
        "route_table_sha256": { "$ref": "#/$defs/sha256" },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "driver", "mtu", "speed_mbps"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "driver": { "type": "string", "minLength": 1 },
              "mtu": { "type": "integer", "minimum": 576 },
              "speed_mbps": { "type": "number", "exclusiveMinimum": 0 },
              "rdma_device": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
