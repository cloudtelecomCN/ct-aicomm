{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudtelecom.cn/schemas/bench/environment-fingerprint.v1.json",
  "title": "CT-Bench environment fingerprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hardware", "kernel", "drivers", "protocol_stack", "network"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_model", "cpu_arch", "logical_cores", "memory_bytes"],
      "properties": {
        "cpu_model": { "type": "string", "minLength": 1 },
        "cpu_arch": { "type": "string", "minLength": 1 },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "accelerators": { "type": "array", "items": { "type": "string" } }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "protocol_stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "artifact_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "mtu", "address_family"],
      "properties": {
        "topology": { "type": "string", "minLength": 1 },
        "mtu": { "type": "integer", "minimum": 576 },
        "address_family": { "enum": ["ipv4", "ipv6", "dual"] },
        "declared_rtt_ms": { "type": "number", "minimum": 0 },
        "declared_bandwidth_mbps": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
